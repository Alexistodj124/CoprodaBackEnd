# --- Modelo ---
# suscripcion = tu sesion de Claude Code (`claude auth login`), sin API key.
# api         = Messages API; requiere ANTHROPIC_API_KEY.
AGENTE_BACKEND=suscripcion
# ANTHROPIC_API_KEY=sk-ant-...
AGENTE_MODELO=claude-opus-5
AGENTE_MAX_TOKENS=16000
# low | medium | high | xhigh | max. Vacio = default del modelo.
AGENTE_EFFORT=

# --- Backend Coproda ---
COPRODA_API_URL=https://coprodasa.com/api4/coproda
# Backend local, si lo necesitas: http://localhost:5000/coproda
COPRODA_API_TIMEOUT=20
COPRODA_CACHE_TTL=60

# --- Agente ---
AGENTE_MAX_ITERACIONES=6
AGENTE_DEBUG=0
# Solo pruebas: fuerza rol (vendedor | produccion | admin)
# AGENTE_ROL_OVERRIDE=admin

# --- WhatsApp Cloud API: python main.py whatsapp ---
# Phone Number ID y token: developers.facebook.com > tu app > WhatsApp > API Setup.
# WA_PHONE_NUMBER_ID=
# WA_TOKEN=
# Cadena inventada por ti; la misma va en Meta > Webhooks > Verify token.
# WA_VERIFY_TOKEN=
# App settings > Basic > App secret. Vacio = no se verifica la firma (solo pruebas).
# WA_APP_SECRET=
# Telefonos que el agente atiende, con codigo de pais y sin +, separados por coma.
# WA_NUMEROS_PERMITIDOS=50255555555
# WA_PORT=8000

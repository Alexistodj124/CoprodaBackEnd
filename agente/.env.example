# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODELO=anthropic/claude-opus-5
OPENROUTER_MAX_TOKENS=2000
# Dejar vacio: Opus 5 / Sonnet 5 / Fable 5 rechazan temperature.
# Solo poner valor si usas un modelo viejo (Sonnet 4.6, Haiku 4.5).
OPENROUTER_TEMPERATURA=

# --- Backend Coproda ---
COPRODA_API_URL=https://coprodasa.com/api4/coproda
# Backend local, si lo necesitas: http://localhost:5000/coproda
COPRODA_API_TIMEOUT=20
COPRODA_CACHE_TTL=60

# --- Agente ---
AGENTE_MAX_ITERACIONES=6
AGENTE_DEBUG=0
# Solo pruebas: fuerza rol (vendedor | produccion | admin)
# AGENTE_ROL_OVERRIDE=admin

# --- WhatsApp (fase 2, aun no usado) ---
# WA_PHONE_NUMBER_ID=
# WA_TOKEN=
# WA_VERIFY_TOKEN=
